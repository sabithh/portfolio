      this.bot = this.el.querySelector('.js-ai-bot')
      this.botPupils = this.el.querySelectorAll('.js-pupil')
      this.snakeCanvas = this.el.querySelector('.js-snake-canvas')

      if (this.snakeCanvas) {
        this.ctx = this.snakeCanvas.getContext('2d')
        this.initSnake()
      }

      // Properties
