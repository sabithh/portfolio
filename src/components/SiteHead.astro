    }

    /**
     * Init
     */
    init() {
      this.bindEvents()
      this.updateClock()
      setInterval(this.updateClock.bind(this), 1000)
    }

    /**
     * Initialize Snake Game
     */
    initSnake() {
      // @ts-ignore
      this.snakeGrid = 4;
      // @ts-ignore
      this.snakeCols = 12; // default
      // @ts-ignore
      this.snakeRows = 12; // default

      // @ts-ignore
      this.snakeData = [{x: 6, y: 6}];
      // @ts-ignore
      this.foodData = {x: 3, y: 3};
      // @ts-ignore
      this.snakeDx = 1;
      // @ts-ignore
      this.snakeDy = 0;
      // @ts-ignore
      this.lastSnakeTime = 0;
      // @ts-ignore
      this.isGameOver = false;
      // @ts-ignore
      this.hasStartedPlaying = false;

      // Handle dynamic stretching of the canvas container
      const resizeObserver = new ResizeObserver(entries => {
        for (let entry of entries) {
          const w = Math.floor(entry.contentRect.width);
          const h = Math.floor(entry.contentRect.height);
          this.snakeCanvas.width = w;
          this.snakeCanvas.height = h;
          // @ts-ignore
          this.snakeCols = Math.floor(w / this.snakeGrid);
          // @ts-ignore
          this.snakeRows = Math.floor(h / this.snakeGrid);

          // prevent out of bounds when resizing smaller
          // @ts-ignore
          if (this.foodData.x >= this.snakeCols) this.foodData.x = this.snakeCols - 1;
          // @ts-ignore
          if (this.foodData.y >= this.snakeRows) this.foodData.y = this.snakeRows - 1;
        }
      });
      // @ts-ignore
      resizeObserver.observe(this.snakeCanvas.parentElement);

      this.snakeCanvas.addEventListener('keydown', (e) => {
        if (['ArrowUp', 'ArrowDown', 'ArrowLeft', 'ArrowRight'].includes(e.key)) {
          e.preventDefault();
          // @ts-ignore
          this.hasStartedPlaying = true;
          // @ts-ignore
          if (e.key === 'ArrowUp' && this.snakeDy === 0) { this.snakeDx = 0; this.snakeDy = -1; }
          // @ts-ignore
          else if (e.key === 'ArrowDown' && this.snakeDy === 0) { this.snakeDx = 0; this.snakeDy = 1; }
          // @ts-ignore
          else if (e.key === 'ArrowLeft' && this.snakeDx === 0) { this.snakeDx = -1; this.snakeDy = 0; }
          // @ts-ignore
          else if (e.key === 'ArrowRight' && this.snakeDx === 0) { this.snakeDx = 1; this.snakeDy = 0; }
        }
      });

      this.snakeCanvas.addEventListener('click', () => {
        // @ts-ignore
        if (this.isGameOver) {
          // @ts-ignore
          this.snakeData = [{x: Math.floor(this.snakeCols/2), y: Math.floor(this.snakeRows/2)}];
          // @ts-ignore
          this.snakeDx = 1; this.snakeDy = 0;
          // @ts-ignore
          this.isGameOver = false;
        }
      });

      requestAnimationFrame(this.snakeLoop.bind(this));
    }

    snakeLoop(time: number) {
      if (!this.snakeCanvas) return;
      requestAnimationFrame(this.snakeLoop.bind(this));

      // @ts-ignore
      if (time - this.lastSnakeTime < 80) return;
      // @ts-ignore
      this.lastSnakeTime = time;

      // @ts-ignore
      if (this.isGameOver) {
        // Blink if game over
        // @ts-ignore
        if (Math.floor(time / 500) % 2 === 0) {
          this.drawSnake();
        } else {
          this.ctx.clearRect(0, 0, this.snakeCanvas.width, this.snakeCanvas.height);
        }
        return;
      }

      // Automatically move if not started randomly maybe? 
      // User requested "JUST SIMPLY RUNNING AROUND"
      // @ts-ignore
      if (!this.hasStartedPlaying) {
        // Simple AI to wander around
        if (Math.random() < 0.1) {
          // @ts-ignore
          const dirs = [{dx: 0, dy: -1}, {dx: 0, dy: 1}, {dx: -1, dy: 0}, {dx: 1, dy: 0}];
          // @ts-ignore
          const validDirs = dirs.filter(d => !(d.dx === -this.snakeDx && d.dy === -this.snakeDy));
          const next = validDirs[Math.floor(Math.random() * validDirs.length)];
          // @ts-ignore
          this.snakeDx = next.dx; this.snakeDy = next.dy;
        }
      }

      // @ts-ignore
      const head = { x: this.snakeData[0].x + this.snakeDx, y: this.snakeData[0].y + this.snakeDy };

      // @ts-ignore
      if (head.x < 0) head.x = this.snakeCols - 1;
      // @ts-ignore
      else if (head.x >= this.snakeCols) head.x = 0;
      // @ts-ignore
      if (head.y < 0) head.y = this.snakeRows - 1;
      // @ts-ignore
      else if (head.y >= this.snakeRows) head.y = 0;

      let collided = false;
      // @ts-ignore
      for (let i = 0; i < this.snakeData.length; i++) {
        // @ts-ignore
        if (this.snakeData[i].x === head.x && this.snakeData[i].y === head.y) {
          collided = true;
          break;
        }
      }
      if (collided) {
        // @ts-ignore
        this.isGameOver = true;
        return;
      }

      // @ts-ignore
      this.snakeData.unshift(head);

      // @ts-ignore
      if (head.x === this.foodData.x && head.y === this.foodData.y) {
        // @ts-ignore
        this.foodData = { x: Math.floor(Math.random() * this.snakeCols), y: Math.floor(Math.random() * this.snakeRows) };
      } else {
        // @ts-ignore
        this.snakeData.pop();
      }

      this.drawSnake();
    }

    drawSnake() {
      if (!this.ctx || !this.snakeCanvas) return;
      this.ctx.clearRect(0, 0, this.snakeCanvas.width, this.snakeCanvas.height);
      
      // Ensures the color dynamically fully matches the text color of the current theme
      const liveColor = getComputedStyle(this.snakeCanvas).color || '#000';
      this.ctx.fillStyle = liveColor;
      
      // @ts-ignore
      this.ctx.fillRect(this.foodData.x * this.snakeGrid, this.foodData.y * this.snakeGrid, this.snakeGrid, this.snakeGrid);

      // @ts-ignore
      for (const segment of this.snakeData) {
        // @ts-ignore
        this.ctx.fillRect(segment.x * this.snakeGrid, segment.y * this.snakeGrid, this.snakeGrid, this.snakeGrid);
      }
    }

    /**
     * Update clock
     */
    updateClock() {
      if (!this.clock) return
      const now = new Date()
      const hours = String(now.getHours()).padStart(2, '0')
      const minutes = String(now.getMinutes()).padStart(2, '0')
      const seconds = String(now.getSeconds()).padStart(2, '0')
      this.clock.textContent = `${hours}:${minutes}:${seconds}`
    }

    /**
     * Bind events
     */
    bindEvents() {
      this.contrastButton.addEventListener(
        'click',
        this.toggleContrast.bind(this),
        { passive: true },
      )

      this.links.forEach((link) => {
        link.addEventListener('click', this.moveToSection.bind(this))
      })

      document.addEventListener('intro', this.intro.bind(this), { once: true })
      document.addEventListener('mousemove', this.onMouseMove.bind(this), { passive: true })

      if (this.bot) {
        this.bot.addEventListener('click', this.onBotClick.bind(this))
      }

      this.el.addEventListener('intersect', this.onIntersect.bind(this), {
        passive: true,
      })
    }

    /**
     * Mouse tracking for bot eyes
     */
    onMouseMove(e) {
      if (!this.botPupils || this.botPupils.length === 0) return
      
      const mouseX = e.clientX
      const mouseY = e.clientY

      this.botPupils.forEach((pupil: HTMLElement) => {
        const eye = pupil.parentElement
        if (!eye) return
        
        const rect = eye.getBoundingClientRect()
        const eyeCenterX = rect.left + rect.width / 2
        const eyeCenterY = rect.top + rect.height / 2

        const maxMoveX = (rect.width - 4) / 2 // 4 is pupil width
        const maxMoveY = (rect.height - 4) / 2

        const dx = mouseX - eyeCenterX
        const dy = mouseY - eyeCenterY

        let moveX = (dx / window.innerWidth) * maxMoveX * 4
        let moveY = (dy / window.innerHeight) * maxMoveY * 4

        if (moveX > maxMoveX) moveX = maxMoveX
        if (moveX < -maxMoveX) moveX = -maxMoveX
        if (moveY > maxMoveY) moveY = maxMoveY
        if (moveY < -maxMoveY) moveY = -maxMoveY

        pupil.style.transform = `translate(calc(-50% + ${moveX}px), calc(-50% + ${moveY}px))`
      })
    }

    /**
     * Bot interaction mode toggle
     */
    onBotClick() {
      if (!this.bot) return
      const modes = ['', 'is-happy', 'is-sleeping', 'is-hacking']
      let curr = 0
      modes.forEach((m, idx) => {
        if (m && this.bot.classList.contains(m)) curr = idx
      })
      if (modes[curr]) this.bot.classList.remove(modes[curr])
      curr = (curr + 1) % modes.length
      if (modes[curr]) this.bot.classList.add(modes[curr])
    }

    /**
     * Intersect handler
     */
    onIntersect(e) {
      this.isPaused = !e.detail.isIntersecting

      if (this.isPaused) {
        Emitter.off('tick', this.updateConsole, this)
      } else {
        Emitter.on('tick', this.updateConsole, this)
      }
    }

    /**
     * Intro
     */
    intro() {
      const logo = this.el.querySelector('.js-logo')
      const menuItems = this.el.querySelectorAll('.js-menu-item')
      const qrCode = this.el.querySelector('.js-qr-code')

      const items = [logo, ...menuItems]

      const tl = gsap.timeline()

      tl.set(this.el, {
        opacity: 1,
      })

      tl.from(
        this.el,
        {
          y: '-100%',
          duration: 1.5,
          ease: 'expo.inOut',
        },
        1,
      )

      tl.from(
        items,
        {
          y: '-100%',
          duration: 1.5,
          ease: 'expo.out',
          stagger: 0.1,
        },
        1.5,
      )

      tl.fromTo(
        qrCode,
        {
          '--bg-p': '0%',
        },
        {
          '--bg-p': '100%',
          duration: 1.5,
          ease: 'expo.out',
        },
        1.75,
      )

      tl.call(
        () => {
          this.canWrite = true
        },
        null,
        1.5,
      )
    }

    /**
     * Toggle contrast
     */
    toggleContrast() {
      let fromX = '0'
      let toX = '-100%'

      if (document.documentElement.classList.contains('theme-contrasted')) {
        fromX = '-100%'
        toX = '0'
      }

      gsap.fromTo(
        this.contrastMask,
        {
          x: fromX,
        },
        {
          x: toX,
          duration: 1,
          ease: 'expo.inOut',
          onComplete: () => {
            this.contrastMask.style.transform = ''

            if (toX === '0') {
              document.documentElement.classList.remove('theme-contrasted')
            } else {
              document.documentElement.classList.add('theme-contrasted')
            }

            Emitter.emit(
              'contrastchange',
              document.documentElement.classList.contains('theme-contrasted')
                ? 'contrasted'
                : 'default',
            )
          },
        },
      )

      if (toX !== '0') {
        document.documentElement.classList.add('theme-contrasted')
      }
    }

    /**
     * Move to section
     */
    moveToSection(e) {
      e.preventDefault()

      const id = e.currentTarget.getAttribute('href')

      window.lenis.scrollTo(id, {
        duration: 1.5,
        easing: (t) =>
          t < 0.5 ? 16 * t * t * t * t * t : 1 + 16 * --t * t * t * t * t,
      })
    }

    /**
     * Update console
     */
    updateConsole(time) {
      if (!this.canWrite || time - this.lastTypeTime < this.writeDelay) {
        return
      }

      if (this.message === '') {
        this.message = this.getRandomMessage()
        this.writeDelay = 2000
      } else {
        if (this.message === this.lastMessage || this.messageLineBreak) {
          this.console.textContent += '\n'
        }

        const char = this.message.charAt(0)
        this.message = this.message.substring(1)

        if (char === ',') {
          this.writeDelay = 100
        } else if (char === ' ') {
          this.writeDelay = 100
        } else if (char === '') {
          this.writeDelay = 200
        } else if (char === '…') {
          this.writeDelay = 400
        } else if (char === '.') {
          this.writeDelay = 400
        } else {
          this.writeDelay = 20
        }

        this.console.textContent += char

        if (char === '…') {
          this.messageLineBreak = true
        } else {
          this.messageLineBreak = false
        }
      }

      this.console.textContent = this.console.textContent
        .split('\n')
        .slice(-5)
        .join('\n')

      this.lastTypeTime = time
    }

    /**
     * Get random message
     */
    getRandomMessage() {
      let message =
        this.messages[Math.floor(Math.random() * this.messages.length)]

      if (message === this.lastMessage) {
        message = this.getRandomMessage()
      }

      this.lastMessage = message

      return message
    }
  }

  new Section()
</script>

